{
  "openapi": "3.1.0",
  "info": {
    "title": "DRPAY Merchant API",
    "version": "1.0.0",
    "description": "Merchant-scoped wallet, payment-link, institution, and USDT deposit endpoints. API keys are environment-specific bearer tokens. Use the read scope for GET operations and payments:write to create payment links."
  },
  "servers": [
    {
      "url": "https://api.paypulse.live",
      "description": "Production"
    },
    {
      "url": "https://api.sandbox.paypulse.live",
      "description": "Sandbox"
    }
  ],
  "security": [
    {
      "MerchantBearerToken": []
    }
  ],
  "tags": [
    { "name": "Wallet" },
    { "name": "Payment links" },
    { "name": "Institutions" },
    { "name": "USDT" }
  ],
  "paths": {
    "/v1/wallet/balance": {
      "get": {
        "tags": ["Wallet"],
        "summary": "Read merchant wallet balance",
        "description": "Returns the authenticated merchant's posted PHP balance and pending transfer reservations.",
        "operationId": "getMerchantWalletBalance",
        "x-required-scopes": ["read"],
        "responses": {
          "200": {
            "description": "Merchant wallet balances.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WalletBalance" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/wallet/activity": {
      "get": {
        "tags": ["Wallet"],
        "summary": "List merchant wallet activity",
        "description": "Returns merchant-scoped payments, disbursements, and wallet adjustments. Amount is the gross transaction amount; walletAmount is the signed ledger impact and may be null before posting.",
        "operationId": "listMerchantWalletActivity",
        "x-required-scopes": ["read"],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of records to return.",
            "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 50 }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Zero-based pagination offset.",
            "schema": { "type": "integer", "minimum": 0, "default": 0 }
          },
          {
            "name": "from",
            "in": "query",
            "description": "Inclusive start date in YYYY-MM-DD format.",
            "schema": { "type": "string", "format": "date" }
          },
          {
            "name": "to",
            "in": "query",
            "description": "Inclusive end date in YYYY-MM-DD format.",
            "schema": { "type": "string", "format": "date" }
          }
        ],
        "responses": {
          "200": {
            "description": "Activity records.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/WalletActivity" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/internal-wallet": {
      "get": {
        "tags": ["Wallet"],
        "summary": "Read floating wallet balance",
        "description": "Returns the separate DRPAY-funded floating wallet. It is not the merchant's operational wallet balance.",
        "operationId": "getMerchantInternalWallet",
        "x-required-scopes": ["read"],
        "responses": {
          "200": {
            "description": "Floating wallet balances and fee.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InternalWallet" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/payment-links": {
      "post": {
        "tags": ["Payment links"],
        "summary": "Create a hosted payment link",
        "description": "Creates a PHP QRPH collection and a DRPAY-hosted checkout. A successful response means the checkout was created, not that it was paid. On an ambiguous timeout, reconcile the original request before retrying.",
        "operationId": "createPaymentLink",
        "x-required-scopes": ["payments:write"],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "description": "Unique per intended payment; reuse only when retrying that same request after an ambiguous outcome.",
            "schema": {
              "type": "string",
              "minLength": 16,
              "maxLength": 100,
              "pattern": "^[a-zA-Z0-9._:-]+$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePaymentLinkRequest" },
              "example": {
                "amount": 125.5,
                "currency": "PHP",
                "description": "Invoice 1048",
                "customerEmail": "customer@example.com"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Payment link created.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreatedPaymentLink" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "502": { "$ref": "#/components/responses/BadGateway" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/payment-links/{code}": {
      "get": {
        "tags": ["Payment links"],
        "summary": "Read payment status",
        "description": "Refreshes and returns the status of a payment link owned by the authenticated merchant. Treat only EXECUTED as confirmed payment; MANUALLY_PAID indicates an independently verified payment.",
        "operationId": "getPaymentLinkStatus",
        "x-required-scopes": ["read"],
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "description": "Opaque payment checkout code.",
            "schema": { "type": "string", "minLength": 1 }
          }
        ],
        "responses": {
          "200": {
            "description": "Current payment status.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PaymentLinkStatus" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/payment-institutions": {
      "get": {
        "tags": ["Institutions"],
        "summary": "List payment institutions",
        "description": "Returns enabled collection institutions available in the current payment environment.",
        "operationId": "listPaymentInstitutions",
        "x-required-scopes": ["read"],
        "responses": {
          "200": {
            "description": "Collection institutions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Institution" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/disbursement-institutions": {
      "get": {
        "tags": ["Institutions"],
        "summary": "List disbursement institutions",
        "description": "Returns available transfer institutions. Optionally filter by INSTAPAY or PESONET.",
        "operationId": "listDisbursementInstitutions",
        "x-required-scopes": ["read"],
        "parameters": [
          {
            "name": "channel",
            "in": "query",
            "schema": { "type": "string", "enum": ["INSTAPAY", "PESONET"] }
          }
        ],
        "responses": {
          "200": {
            "description": "Disbursement institutions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Institution" }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/crypto/usdt-wallet": {
      "get": {
        "tags": ["USDT"],
        "summary": "Read assigned USDT wallet",
        "description": "Returns the assigned TRON wallet and mainnet balance when the service is configured. A null balance or configured=false means the balance service is unavailable; it does not represent a zero balance.",
        "operationId": "getMerchantUsdtWallet",
        "x-required-scopes": ["read"],
        "responses": {
          "200": {
            "description": "Assigned wallet and configuration state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsdtWallet" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    },
    "/v1/crypto/usdt-deposits": {
      "get": {
        "tags": ["USDT"],
        "summary": "List confirmed USDT deposits",
        "description": "Returns confirmed incoming TRON mainnet USDT transfers for this merchant's assigned wallet.",
        "operationId": "listMerchantUsdtDeposits",
        "x-required-scopes": ["read"],
        "responses": {
          "200": {
            "description": "Confirmed deposits and wallet configuration state.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/UsdtDepositHistory" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "503": { "$ref": "#/components/responses/ServiceUnavailable" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MerchantBearerToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "DRPAY merchant API key",
        "description": "Use a merchant API key created for the same environment as the server. API keys are shown once and must be kept server-side. Scope requirements are listed on each operation."
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": { "type": "string" }
        },
        "additionalProperties": true
      },
      "WalletBalance": {
        "type": "object",
        "required": ["balance", "availableBalance", "reservedBalance", "walletMode", "paymentEnvironment", "cumulativeKrwCollections"],
        "properties": {
          "balance": { "type": "number", "description": "Posted merchant ledger balance in PHP." },
          "availableBalance": { "type": "number", "description": "Posted balance less pending transfer reservations, in PHP." },
          "reservedBalance": { "type": "number", "description": "Amount reserved for pending transfers, in PHP." },
          "walletMode": { "type": "string", "enum": ["pooled"] },
          "paymentEnvironment": { "type": "string", "enum": ["sandbox", "production"] },
          "cumulativeKrwCollections": { "type": "number", "description": "Cumulative completed KRW collection amount." }
        }
      },
      "InternalWallet": {
        "type": "object",
        "required": ["currency", "balance", "availableBalance", "transferFeeFixed", "label"],
        "properties": {
          "currency": { "type": "string", "enum": ["PHP"] },
          "balance": { "type": "number" },
          "availableBalance": { "type": "number" },
          "transferFeeFixed": { "type": "number" },
          "label": { "type": "string" }
        }
      },
      "WalletActivity": {
        "type": "object",
        "required": ["id", "referenceNo", "description", "channel", "status", "amount", "walletAmount", "createdAt", "transactionType"],
        "properties": {
          "id": { "type": "string" },
          "referenceNo": { "type": ["string", "null"] },
          "institutionCode": { "type": ["string", "null"] },
          "description": { "type": "string" },
          "institutionName": { "type": ["string", "null"] },
          "institutionLogoUrl": { "type": ["string", "null"], "format": "uri" },
          "recipientName": { "type": ["string", "null"] },
          "recipientAccountNumber": { "type": ["string", "null"] },
          "remarks": { "type": ["string", "null"] },
          "isRefund": { "type": "boolean" },
          "channel": { "type": "string" },
          "status": { "type": "string" },
          "amount": { "type": "number", "description": "Gross payment amount or signed transfer amount." },
          "walletAmount": { "type": ["number", "null"], "description": "Signed posted ledger impact; null until posted." },
          "createdAt": { "type": "string", "format": "date-time" },
          "transactionType": { "type": "string", "enum": ["PAYMENT_LINK", "DISBURSEMENT", "ADMIN_ADJUSTMENT"] },
          "canRefund": { "type": "boolean" },
          "refundStatus": { "type": ["string", "null"] }
        },
        "additionalProperties": true
      },
      "CreatePaymentLinkRequest": {
        "type": "object",
        "required": ["amount", "description"],
        "properties": {
          "amount": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000, "multipleOf": 0.01, "description": "PHP amount, up to two decimal places." },
          "currency": { "type": "string", "enum": ["PHP"], "default": "PHP" },
          "description": { "type": "string", "minLength": 1, "maxLength": 100 },
          "customerEmail": { "type": "string", "format": "email", "maxLength": 254 },
          "collectionAmountKrw": { "type": "integer", "minimum": 1, "description": "Optional whole-number KRW display amount associated with a PHP checkout." },
          "institutionCode": {
            "type": "string",
            "maxLength": 64,
            "description": "Use DRPAY_VIRTUAL_ACCOUNT with institutionName Virtual Account to include provider-returned Virtual Account details."
          },
          "institutionName": { "type": "string", "maxLength": 120 },
          "institutionLogoUrl": { "type": "string", "format": "uri" },
          "institutionDeepLink": { "type": "string", "format": "uri" },
          "checkoutInstructions": { "type": "string" },
          "emailSubject": { "type": "string" },
          "emailMessage": { "type": "string" },
          "emailBrandColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "emailLogoUrl": { "type": "string", "format": "uri" }
        }
      },
      "CreatedPaymentLink": {
        "type": "object",
        "required": ["id", "code", "paymentUrl", "qrCode", "qrImageUrl", "status", "amount", "currency", "requestEmailStatus"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "paymentUrl": { "type": "string", "format": "uri" },
          "qrCode": { "type": "string", "description": "QR payment payload." },
          "qrImageUrl": { "type": "string", "format": "uri" },
          "status": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string", "enum": ["PHP"] },
          "virtualAccountInfo": { "$ref": "#/components/schemas/VirtualAccountInfo" },
          "requestEmailStatus": {
            "type": "string",
            "enum": ["queued", "sent", "no_customer_email", "queue_failed"]
          }
        }
      },
      "VirtualAccountInfo": {
        "type": "object",
        "description": "SwiftPay-provided Virtual Account details associated with the generated QRPH code.",
        "properties": {
          "bankAccountNumber": { "type": "string" },
          "instapayBankCode": { "type": "string" },
          "referenceNo": { "type": "string" }
        }
      },
      "PaymentLinkStatus": {
        "type": "object",
        "required": ["code", "paymentUrl", "status", "amount", "currency", "referenceNo"],
        "properties": {
          "code": { "type": "string" },
          "paymentUrl": { "type": "string", "format": "uri" },
          "status": { "type": "string", "enum": ["PENDING", "EXECUTED", "CANCELED", "REJECTED", "EXPIRED", "MANUALLY_PAID"] },
          "amount": { "type": "number" },
          "currency": { "type": "string", "enum": ["PHP"] },
          "referenceNo": { "type": "string" }
        }
      },
      "Institution": {
        "type": "object",
        "properties": {
          "code": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" },
          "logoUrl": { "type": "string", "format": "uri" },
          "deepLink": { "type": "string", "format": "uri" }
        },
        "additionalProperties": true
      },
      "UsdtWallet": {
        "type": "object",
        "required": ["address", "network", "balance", "configured", "message"],
        "properties": {
          "address": { "type": ["string", "null"] },
          "network": { "type": "string", "enum": ["TRON_MAINNET", "TRON_SHASTA"] },
          "balance": { "type": ["string", "null"], "description": "USDT balance, or null when balance lookup is unavailable." },
          "qualifyingBalance": { "type": ["string", "null"] },
          "configured": { "type": "boolean" },
          "message": { "type": ["string", "null"] },
          "activation": { "type": "object", "additionalProperties": true },
          "integrationEmailStatus": { "type": "string" }
        }
      },
      "UsdtDepositHistory": {
        "type": "object",
        "required": ["deposits", "configured", "message"],
        "properties": {
          "deposits": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UsdtDeposit" }
          },
          "configured": { "type": "boolean" },
          "assignedAt": { "type": ["string", "null"], "format": "date-time" },
          "message": { "type": ["string", "null"] }
        }
      },
      "UsdtDeposit": {
        "type": "object",
        "required": ["transactionId", "amount", "from", "blockTimestamp", "confirmed"],
        "properties": {
          "transactionId": { "type": "string" },
          "amount": { "type": "string" },
          "from": { "type": "string" },
          "blockTimestamp": { "type": "string", "format": "date-time" },
          "confirmed": { "type": "boolean" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request parameters or body.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Unauthorized": {
        "description": "Missing, invalid, revoked, or wrong-environment credentials.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Forbidden": {
        "description": "The API key is missing the required scope.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "NotFound": {
        "description": "The resource was not found or does not belong to this merchant.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "Conflict": {
        "description": "The idempotency key was reused with different request data.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "RateLimited": {
        "description": "Request rate limit exceeded.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "BadGateway": {
        "description": "The payment provider could not create the checkout.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      },
      "ServiceUnavailable": {
        "description": "A temporary or ambiguous service outcome. Reconcile before retrying a payment-link create request.",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiError" } } }
      }
    }
  }
}
